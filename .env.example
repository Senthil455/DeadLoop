# DEADLOOP runtime configuration.
#
# This file is a reference and a template for Docker Compose. The backend reads
# environment variables directly; it does not load .env automatically.
# Replace every placeholder before using this in production.

# development | staging | production | qa
DEADLOOP_ENV=production

# Docker Compose host binding. Keep localhost unless a trusted reverse proxy is in front.
DEADLOOP_BIND_ADDRESS=127.0.0.1
DEADLOOP_PORT=8000

# Required in production. Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The default dev-admin-token is rejected when DEADLOOP_ENV=production.
DEADLOOP_ADMIN_TOKEN=replace-with-a-long-random-token

# SQLite is the default. The path is relative to the backend working directory.
# Docker Compose overrides this with its named-volume path.
DEADLOOP_DATABASE_URL=sqlite:///data/deadloop.db

# Comma-separated exact origins. The dashboard is same-origin when served by
# the backend, so CORS is only needed for a separate Vite/dev frontend.
DEADLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Request limits.
DEADLOOP_MAX_REQUEST_BYTES=262144
DEADLOOP_MAX_BATCH_SIZE=100

# Production should run migrations and must not auto-create schema.
DEADLOOP_AUTO_CREATE=0

# Point this at the built SPA when the layout differs from ../frontend/dist.
# DEADLOOP_FRONTEND_DIST=/app/frontend/dist

# Optional OpenAI-compatible explanations. Leave disabled for a fully local
# deployment. AI never participates in detection or intervention decisions.
DEADLOOP_AI_ENABLED=false
DEADLOOP_AI_BASE_URL=http://127.0.0.1:11434/v1
DEADLOOP_AI_MODEL=
DEADLOOP_AI_API_KEY=
DEADLOOP_AI_TIMEOUT_SECONDS=12
